# Python environments
.venv/
venv/
__pycache__/
*.py[cod]

# Testing and notebooks
.pytest_cache/
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Operating system files
.DS_Store
Thumbs.db

# Raw datasets
data/raw/*
!data/raw/.gitkeep

# Intermediate and processed datasets
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Sample data
!data/sample/
data/sample/*
!data/sample/.gitkeep

# Reference data
data/reference/*
!data/reference/.gitkeep

# Generated data and databases
*.parquet
*.duckdb
*.db
*.sqlite

# Logs
*.log

# Module-level datasets and generated files
modules/*/data/*
!modules/*/data/*/
modules/*/data/*/*
!modules/*/data/*/.gitkeep
